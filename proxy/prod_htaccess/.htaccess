RewriteEngine On

# Pass the Authorization header to PHP under FastCGI (mod_fcgid), so scoped
# API tokens (Authorization: Bearer ...) reach the backend.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Redirect ALL requests to index.php
RewriteRule ^(.*)$ index.php [QSA,L]

# Default Cache-Control, only for responses that carry none (e.g. static assets):
# - never override a Cache-Control the backend already sent (private for
#   responses that set a cookie, no-store for Bearer and errors);
# - never mark token-authenticated (Authorization: Bearer ...) responses as
#   public, so shared caches don't store them.
# Under mod_fcgid the headers sent by PHP live in the "always" table, under
# mod_php in the default one. "always setifempty" covers the first and the
# resp() check (which reads both tables) covers the second, so the backend's
# value wins under either handler.
Header always setifempty Cache-Control "max-age=10, public" "expr=-z %{req:Authorization} && -z resp('Cache-Control')"
