{
  "name": "majora-client",
  "version": "0.1.0",
  "description": "Node.js client for the Majora RPG campaign manager API",
  "type": "module",
  "main": "src/index.js",
  "exports": "./src/index.js",
  "bin": {
    "majora": "bin/majora.js"
  },
  "files": [
    "src/",
    "bin/",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "jasmine --config=specs/support/jasmine.json",
    "lint": "eslint src specs bin",
    "lint_fix": "eslint src specs bin --fix",
    "coverage": "c8 jasmine --config=specs/support/jasmine.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darthjee/majora.git",
    "directory": "client"
  },
  "author": "darthjee",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "c8": "11.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-complexity": "^1.0.2",
    "eslint-plugin-jasmine": "^4.1.3",
    "eslint-plugin-jsdoc": "^63.0.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-security-node": "^1.1.4",
    "globals": "^16.5.0",
    "jasmine": "^5.0.0"
  },
  "c8": {
    "reporter": [
      "text",
      "lcov"
    ],
    "report-dir": "coverage",
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "specs/**"
    ],
    "all": true
  }
}
